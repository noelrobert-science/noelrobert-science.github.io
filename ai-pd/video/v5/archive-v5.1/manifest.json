 "cues": [
  {
   "scene": 1,
   "cue": "honest",
   "a": 1.8,
   "b": 2.518,
   "text": "Be honest."
  },
  {
   "scene": 1,
   "cue": "how",
   "a": 2.991,
   "b": 4.582,
   "text": "How do your pupils use AI?"
  },
  {
   "scene": 1,
   "cue": "search",
   "a": 5.257,
   "b": 7.135,
   "text": "For most, it's a search box:"
  },
  {
   "scene": 1,
   "cue": "copy",
   "a": 7.338,
   "b": 9.352,
   "text": "type the question, copy the answer."
  },
  {
   "scene": 1,
   "cue": "anthropic",
   "a": 10.027,
   "b": 12.732,
   "text": "When Anthropic looked at university students' chats,"
  },
  {
   "scene": 1,
   "cue": "half",
   "a": 12.867,
   "b": 16.01,
   "text": "almost half asked straight for an answer, or finished work."
  },
  {
   "scene": 2,
   "cue": "matter",
   "a": 18.01,
   "b": 18.897,
   "text": "Does that matter?"
  },
  {
   "scene": 2,
   "cue": "tested",
   "a": 19.504,
   "b": 23.599,
   "text": "Researchers tested it with nearly a thousand high-school maths pupils in Türkiye."
  },
  {
   "scene": 2,
   "cue": "practice",
   "a": 24.139,
   "b": 28.541,
   "text": "While they practised with an open chatbot, their scores jumped by 48 percent."
  },
  {
   "scene": 2,
   "cue": "taken",
   "a": 29.216,
   "b": 31.397,
   "text": "Then the AI was taken away for the exam."
  },
  {
   "scene": 2,
   "cue": "lower",
   "a": 32.004,
   "b": 35.333,
   "text": "They scored 17 percent lower than pupils who never had AI."
  },
  {
   "scene": 2,
   "cue": "soared",
   "a": 36.143,
   "b": 36.949,
   "text": "Practice soared."
  },
  {
   "scene": 2,
   "cue": "sank",
   "a": 37.354,
   "b": 38.198,
   "text": "Learning sank."
  },
  {
   "scene": 2,
   "cue": "tutor",
   "a": 39.143,
   "b": 43.319,
   "text": "But a tutor version, which gave hints instead of answers, did no harm."
  },
  {
   "scene": 3,
   "cue": "why",
   "a": 45.319,
   "b": 46.404,
   "text": "Why does it go wrong?"
  },
  {
   "scene": 3,
   "cue": "four",
   "a": 46.809,
   "b": 47.627,
   "text": "Four traps."
  },
  {
   "scene": 3,
   "cue": "up",
   "a": 48.235,
   "b": 49.261,
   "text": "It makes things up:"
  },
  {
   "scene": 3,
   "cue": "court",
   "a": 49.463,
   "b": 55.563,
   "text": "a South African court could trace only two of the nine cases a legal team had cited, probably invented by AI."
  },
  {
   "scene": 3,
   "cue": "agrees",
   "a": 56.238,
   "b": 57.345,
   "text": "It agrees with you:"
  },
  {
   "scene": 3,
   "cue": "twelve",
   "a": 57.548,
   "b": 63.911,
   "text": "Say “I think the answer is 12, right?” and many chatbots will agree, even when 12 is wrong."
  },
  {
   "scene": 3,
   "cue": "unfair",
   "a": 64.586,
   "b": 68.644,
   "text": "It can be unfair, because it learnt from human writing, bias included."
  },
  {
   "scene": 3,
   "cue": "date",
   "a": 69.184,
   "b": 70.617,
   "text": "And it can be out of date."
  },
  {
   "scene": 4,
   "cue": "brain",
   "a": 72.617,
   "b": 74.361,
   "text": "So keep your brain doing the work."
  },
  {
   "scene": 4,
   "cue": "five",
   "a": 74.833,
   "b": 77.292,
   "text": "Five power-ups, all backed by research:"
  },
  {
   "scene": 4,
   "cue": "p1",
   "a": 77.629,
   "b": 78.542,
   "text": "test yourself,"
  },
  {
   "scene": 4,
   "cue": "p2",
   "a": 78.704,
   "b": 79.72,
   "text": "space it out,"
  },
  {
   "scene": 4,
   "cue": "p3",
   "a": 79.882,
   "b": 80.653,
   "text": "mix it up,"
  },
  {
   "scene": 4,
   "cue": "p4",
   "a": 80.815,
   "b": 81.692,
   "text": "explain it,"
  },
  {
   "scene": 4,
   "cue": "p5",
   "a": 81.854,
   "b": 82.798,
   "text": "make it yourself."
  },
  {
   "scene": 4,
   "cue": "quiz",
   "a": 83.405,
   "b": 86.888,
   "text": "AI can power every one, if you ask it to quiz you, not tell you."
  },
  {
   "scene": 5,
   "cue": "routine",
   "a": 88.888,
   "b": 90.81,
   "text": "Both booklets teach one routine."
  },
  {
   "scene": 5,
   "cue": "r1",
   "a": 91.283,
   "b": 92.31,
   "text": "Attempt it first."
  },
  {
   "scene": 5,
   "cue": "r2",
   "a": 92.58,
   "b": 93.657,
   "text": "Name where you're stuck."
  },
  {
   "scene": 5,
   "cue": "r3",
   "a": 93.927,
   "b": 95.028,
   "text": "Ask for one hint."
  },
  {
   "scene": 5,
   "cue": "r4",
   "a": 95.298,
   "b": 96.212,
   "text": "Check the reply."
  },
  {
   "scene": 5,
   "cue": "r5",
   "a": 96.482,
   "b": 99.5,
   "text": "Then close the AI, and solve a fresh question alone."
  },
  {
   "scene": 5,
   "cue": "ladder",
   "a": 100.175,
   "b": 104.062,
   "text": "Need help? Climb the hint ladder only as high as you need."
  },
  {
   "scene": 5,
   "cue": "last",
   "a": 104.467,
   "b": 106.435,
   "text": "The full answer is the last resort."
  },
  {
   "scene": 6,
   "cue": "pro",
   "a": 108.435,
   "b": 109.379,
   "text": "Prompt like a pro."
  },
  {
   "scene": 6,
   "cue": "words",
   "a": 109.784,
   "b": 112.666,
   "text": "Google found the best prompts average about 21 words;"
  },
  {
   "scene": 6,
   "cue": "nine",
   "a": 112.868,
   "b": 114.671,
   "text": "most people type fewer than nine."
  },
  {
   "scene": 6,
   "cue": "s1",
   "a": 115.211,
   "b": 116.243,
   "text": "Say who you are,"
  },
  {
   "scene": 6,
   "cue": "s2",
   "a": 116.378,
   "b": 117.056,
   "text": "the topic,"
  },
  {
   "scene": 6,
   "cue": "s3",
   "a": 117.191,
   "b": 117.984,
   "text": "what you tried,"
  },
  {
   "scene": 6,
   "cue": "s4",
   "a": 118.119,
   "b": 119.096,
   "text": "the help you want,"
  },
  {
   "scene": 6,
   "cue": "s5",
   "a": 119.231,
   "b": 121.555,
   "text": "and the rules: “Don’t give me the answer.”"
  },
  {
   "scene": 7,
   "cue": "check",
   "a": 123.555,
   "b": 124.368,
   "text": "Then check it."
  },
  {
   "scene": 7,
   "cue": "c1",
   "a": 124.706,
   "b": 125.784,
   "text": "Does it match your book?"
  },
  {
   "scene": 7,
   "cue": "c2",
   "a": 125.986,
   "b": 127.055,
   "text": "Does it make sense?"
  },
  {
   "scene": 7,
   "cue": "itself",
   "a": 127.325,
   "b": 129.219,
   "text": "Never use AI to check itself."
  },
  {
   "scene": 7,
   "cue": "private",
   "a": 129.894,
   "b": 131.635,
   "text": "Keep your private details private."
  },
  {
   "scene": 7,
   "cue": "friend",
   "a": 131.972,
   "b": 133.082,
   "text": "AI is not a friend."
  },
  {
   "scene": 7,
   "cue": "fake",
   "a": 133.487,
   "b": 134.986,
   "text": "And never fake a real person:"
  },
  {
   "scene": 7,
   "cue": "deepfake",
   "a": 135.256,
   "b": 136.92,
   "text": "deepfake abuse is abuse."
  },
  {
   "scene": 8,
   "cue": "moved",
   "a": 138.92,
   "b": 140.413,
   "text": "The world has already moved."
  },
  {
   "scene": 8,
   "cue": "uct",
   "a": 140.818,
   "b": 143.513,
   "text": "UCT has stopped using AI-detection scores."
  },
  {
   "scene": 8,
   "cue": "aloud",
   "a": 143.918,
   "b": 146.214,
   "text": "Students must explain their work out loud,"
  },
  {
   "scene": 8,
   "cue": "declare",
   "a": 146.349,
   "b": 147.901,
   "text": "and declare their AI use."
  },
  {
   "scene": 8,
   "cue": "build",
   "a": 148.508,
   "b": 149.535,
   "text": "What should they build?"
  },
  {
   "scene": 8,
   "cue": "b1",
   "a": 149.873,
   "b": 150.779,
   "text": "Deep knowledge,"
  },
  {
   "scene": 8,
   "cue": "b2",
   "a": 150.914,
   "b": 151.948,
   "text": "thinking out loud,"
  },
  {
   "scene": 8,
   "cue": "b3",
   "a": 152.083,
   "b": 153.254,
   "text": "and AI fluency."
  },
  {
   "scene": 8,
   "cue": "expertise",
   "a": 153.727,
   "b": 155.808,
   "text": "Expertise is what makes AI useful."
  },
  {
   "scene": 9,
   "cue": "wrote",
   "a": 157.808,
   "b": 162.606,
   "text": "So I wrote two booklets, built on this research, with AI as my co-pilot."
  },
  {
   "scene": 9,
   "cue": "junior",
   "a": 163.146,
   "b": 166.184,
   "text": "For Grades 7 to 9: Brain On, AI On."
  },
  {
   "scene": 9,
   "cue": "jtag",
   "a": 166.521,
   "b": 169.719,
   "text": "AI is a power tool. Your brain is the power."
  },
  {
   "scene": 9,
   "cue": "senior",
   "a": 170.326,
   "b": 174.1,
   "text": "For Grades 10 to 12: Co-Pilot, Not Autopilot."
  },
  {
   "scene": 9,
   "cue": "stag",
   "a": 174.437,
   "b": 177.527,
   "text": "You fly the plane. AI helps you navigate."
  },
  {
   "scene": 9,
   "cue": "ready",
   "a": 178.134,
   "b": 179.217,
   "text": "They're ready to try."
  },
  {
   "scene": 9,
   "cue": "measure",
   "a": 180.027,
   "b": 183.507,
   "text": "Because the measure that counts is what you can do when the AI is switched off."
